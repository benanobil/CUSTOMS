/?col1=1\" style={{ fontWeight: params.col1 === '1' ? 'bold' : 'normal' }}>\n            Option 1\n          </Link>\n          <Link href=\"/?col1=2\" style={{ fontWeight: params.col1 === '2' ? 'bold' : 'normal' }}>\n            Option 2\n          </Link>\n          <Link href=\"/?col1=3\" style={{ fontWeight: params.col1 === '3' ? 'bold' : 'normal' }}>\n            Option 3\n          </Link>\n        </SafeAreaView>\n      </SplitView.Column>\n      <SplitView.Column>\n        <SafeAreaView\n          edges={{ left: true, top: true }}\n          style={{\n            flex: 1,\n            gap: 16,\n            padding: 16,\n          }}>\n          <Link href={`/?col1=${params.col1}&col2=1`}>Sub-Option 1</Link>\n          <Link href={`/?col1=${params.col1}&col2=2`}>Sub-Option 2</Link>\n          <Link href={`/?col1=${params.col1}&col2=3`}>Sub-Option 3</Link>\n        </SafeAreaView>\n      </SplitView.Column>\n    </SplitView>\n  );\n}\n"})}),"\n",(0,l.jsxs)(t.h2,{id:"using-splitviewinspector",children:["Using ",(0,l.jsx)(t.code,{children:"SplitView.Inspector"})]}),"\n",(0,l.jsxs)(t.p,{children:[(0,l.jsx)(t.code,{children:"SplitView.Inspector"})," adds a supplementary column that slides in from the trailing edge, useful for showing additional details or metadata:"]}),"\n",(0,l.jsx)(u.C,{alt:"A screenshot of an iPad app using split view with inspector.",src:"/static/images/expo-router/split-view-inspector.png",className:"max-h-[400px]",width:2360,height:1640}),"\n",(0,l.jsx)(t.pre,{children:(0,l.jsx)(t.code,{className:"language-tsx",children:"<SplitView>\n  <SplitView.Column>{/* Sidebar */}</SplitView.Column>\n  <SplitView.Inspector>\n    <View style={{ flex: 1, padding: 16 }}>\n      <Text>Inspector Panel</Text>\n    </View>\n  </SplitView.Inspector>\n</SplitView>\n"})}),"\n",(0,l.jsx)(t.h2,{id:"complete-example",children:"Complete example"}),"\n",(0,l.jsx)(t.p,{children:"Here's a password manager-style app with three columns:"}),"\n",(0,l.jsx)(m.h,{files:["app/_layout.tsx","app/index.tsx","app/[type]/[id].tsx","app/[type]/index.tsx"]}),"\n",(0,l.jsx)(t.pre,{children:(0,l.jsx)(t.code,{className:"language-tsx",children:"@@@app/_layout.tsx@@@import { Link, Color, useGlobalSearchParams } from 'expo-router';\nimport { SplitView } from 'expo-router/unstable-split-view';\nimport { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';\nimport { SafeAreaView } from 'react-native-screens/experimental';\n\nexport default function Layout() {\n  return (\n    <SplitView showInspector>\n      <SplitView.Column>\n        <PasscodeList />\n      </SplitView.Column>\n      <SplitView.Column>\n        <PasswordElementList />\n      </SplitView.Column>\n      <SplitView.Inspector>\n        <InspectorContent />\n      </SplitView.Inspector>\n    </SplitView>\n  );\n}\n\nfunction PasscodeList() {\n  return (\n    <SafeAreaView edges={{ top: true, left: true }} style={style.passcodeList}>\n      <PasscodeCard title=\"All\" param=\"all\" />\n      <PasscodeCard title=\"Passkeys\" param=\"passkeys\" />\n      <PasscodeCard title=\"Codes\" param=\"codes\" />\n      <PasscodeCard title=\"Security\" param=\"security\" />\n      <PasscodeCard title=\"Deleted\" param=\"deleted\" />\n    </SafeAreaView>\n  );\n}\n\nconst passkeys = ['Github', 'Google', 'Facebook', 'Twitter', 'Apple', 'Microsoft', 'Amazon'];\nconst security = ['Admin1234', 'Root'];\n\nconst all = [...passkeys, ...security];\n\nfunction PasswordElementList() {\n  const params = useGlobalSearchParams();\n  const data = (() => {\n    switch (params.type) {\n      case 'all':\n      case undefined:\n        return all;\n      case 'passkeys':\n        return passkeys;\n      case 'security':\n        return security;\n      default:\n        return [];\n    }\n  })();\n  return (\n    <ScrollView contentInsetAdjustmentBehavior=\"automatic\" style={{ backgroundColor: undefined }}>\n      {data.map(item => (\n        <PasswordElement key={item} title={item} />\n      ))}\n    </ScrollView>\n  );\n}\n\nfunction PasscodeCard({ param, title }: { param: string; title: string }) {\n  const params = useGlobalSearchParams();\n  const isActive = params.type === param;\n  return (\n    <Link\n      href={`/${param}/`}\n      disabled={isActive}\n      style={[\n        style.passcodeCard,\n        {\n          backgroundColor: isActive ? Color.ios.systemBlue : Color.ios.systemGray6,\n        },\n      ]}\n      asChild>\n      <Pressable>\n        <Text style={{ color: isActive ? 'white' : 'black', fontSize: 16 }}>{title}</Text>\n      </Pressable>\n    </Link>\n  );\n}\n\nfunction PasswordElement({ title }: { title: string }) {\n  const params = useGlobalSearchParams();\n  const isActive = params.id === title;\n  return (\n    <Link href={`/${params.type}/${title}/`} asChild>\n      <Pressable\n        style={{\n          backgroundColor: isActive ? Color.ios.systemBlue : undefined,\n          padding: 12,\n        }}>\n        <SafeAreaView edges={{ left: true }}>\n          <Text style={{ color: isActive ? 'white' : 'black', fontSize: 16 }}>{title}</Text>\n        </SafeAreaView>\n      </Pressable>\n    </Link>\n  );\n}\n\nfunction InspectorContent() {\n  return (\n    <View style={style.inspectorContent}>\n      <Text>Inspector</Text>\n    </View>\n  );\n}\n\nconst style = StyleSheet.create({\n  passcodeList: {\n    flex: 1,\n    flexWrap: 'wrap',\n    gap: 8,\n    flexDirection: 'row',\n    padding: 8,\n  },\n  passcodeCard: {\n    width: '48%',\n    padding: 12,\n    borderRadius: 12,\n    justifyContent: 'center',\n    alignItems: 'center',\n    height: 50,\n  },\n  inspectorContent: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n  },\n});\n"})}),"\n",(0,l.jsx)(t.pre,{children:(0,l.jsx)(t.code,{className:"language-tsx",children:"@@@app/index.tsx@@@import { Redirect } from 'expo-router';\n\nexport default function Index() {\n  return <Redirect href=\"/all/\" />;\n}\n"})}),"\n",(0,l.jsx)(t.pre,{children:(0,l.jsx)