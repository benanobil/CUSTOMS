"\n",(0,o.jsx)(h.N,{summary:"Contacts infinite scroll example",children:(0,o.jsx)(n.pre,{children:(0,o.jsx)(n.code,{className:"language-tsx",children:"@@@Contacts infinite scroll example@@@import { Contact, ContactField, PartialContactDetails } from 'expo-contacts';\nimport { useEffect, useState } from 'react';\nimport { FlatList, Text, View } from 'react-native';\n\nconst FIELDS = [ContactField.FULL_NAME, ContactField.PHONES] as const;\n\nexport default function InfiniteContacts() {\n  const [contactDetails, setContactDetails] = useState<PartialContactDetails<typeof FIELDS>[]>([]);\n\n  useEffect(() => {\n    loadMore();\n  }, []);\n\n  const loadMore = async () => {\n    const newBatch = await Contact.getAllDetails(FIELDS, {\n      limit: 20,\n      offset: contactDetails.length,\n    });\n    setContactDetails(prev => [...prev, ...newBatch]);\n  };\n\n  return (\n    <View style={{ flex: 1 }}>\n      <FlatList\n        data={contactDetails}\n        keyExtractor={item => item.id}\n        onEndReached={loadMore}\n        onEndReachedThreshold={0.5}\n        renderItem={({ item }) => (\n          <View style={{ padding: 10, borderBottomWidth: 1, borderColor: '#ccc' }}>\n            <Text>{item.fullName}</Text>\n            <Text>{item.phones[0]?.number ?? 'No phone number'}</Text>\n          </View>\n        )}\n      />\n    </View>\n  );\n}\n"})})}),"\n",(0,o.jsx)(h.N,{summary:"Edit contact form example",children:(0,o.jsx)(n.pre,{children:(0,o.jsx)(n.code,{className:"language-tsx",children:"@@@Edit contact form example@@@import { Contact, ContactField, ContactPatch } from 'expo-contacts';\nimport { useEffect, useState } from 'react';\nimport { Alert, Button, ScrollView, Text, TextInput, View } from 'react-native';\n\nexport default function ContactForm() {\n  const [contact, setContact] = useState<Contact | null>(null);\n  const [contactPatch, setContactPatch] = useState<ContactPatch>({});\n  const [newPhoneInput, setNewPhoneInput] = useState('');\n\n  useEffect(() => {\n    Contact.getAll({ limit: 1 }).then(async ([first]) => {\n      if (first) {\n        setContact(first);\n        setContactPatch(await first.getDetails([ContactField.GIVEN_NAME, ContactField.PHONES]));\n      }\n    });\n  }, []);\n\n  if (!contactPatch && contact) {\n    return <Text style={{ marginTop: 50 }}>Loading details...</Text>;\n  }\n\n  const handleChangeName = (text: string) =>\n    setContactPatch(prev => ({ ...prev, givenName: text }));\n\n  const handleAddPhone = () => {\n    if (!newPhoneInput) {\n      return;\n    }\n    setContactPatch(prev => ({\n      ...prev,\n      phones: [...(prev.phones || []), { label: 'mobile', number: newPhoneInput }],\n    }));\n    setNewPhoneInput('');\n  };\n\n  const handleRemovePhone = (idx: number) =>\n    setContactPatch(prev => ({\n      ...prev,\n      phones: prev.phones?.filter((_, i) => i !== idx),\n    }));\n\n  const handlePatch = async () => {\n    if (contact) {\n      await contact.patch(contactPatch);\n    }\n    Alert.alert('Contact patched successfully');\n  };\n\n  if (!contact) {\n    return <Text style={{ marginTop: 50 }}>Loading...</Text>;\n  }\n\n  return (\n    <ScrollView style={{ padding: 20, paddingTop: 60 }}>\n      <Text style={{ fontWeight: 'bold', marginBottom: 10 }}>Edit ID: {contact.id}</Text>\n\n      <Text>Name:</Text>\n      <TextInput\n        style={{ borderWidth: 1, padding: 5, marginBottom: 10 }}\n        value={contactPatch.givenName || ''}\n        onChangeText={handleChangeName}\n      />\n\n      <Text>Phones:</Text>\n      {contactPatch.phones?.map((phone, index) => (\n        <View key={index} style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 5 }}>\n          <Text style={{ flex: 1 }}>{phone.number}</Text>\n          <Button title=\"Remove\" onPress={() => handleRemovePhone(index)} />\n        </View>\n      ))}\n\n      <View style={{ flexDirection: 'row', marginBottom: 20, marginTop: 10 }}>\n        <TextInput\n          style={{ borderWidth: 1, flex: 1, padding: 5, marginRight: 5 }}\n          value={newPhoneInput}\n          onChangeText={setNewPhoneInput}\n          placeholder=\"New phone...\"\n        />\n        <Button title=\"Add\" onPress={handleAddPhone} />\n      </View>\n\n      <Button title=\"PATCH CONTACT\" onPress={handlePatch} />\n    </ScrollView>\n  );\n}\n"})})}),"\n",(0,o.jsx)(n.h2,{id:"api",children:"API"}),"\n",(0,o.jsx)(n.pre,{children:(0,o.jsx)(n.code,{className:"language-jsx",children:"import { Contact } from 'expo-contacts';\n"})}),"\n",(0,o.jsx)(c.A,{packageName:"expo-contacts",apiName:"Contacts"}),"\n",(0,o.jsx)(n.h2,{id:"permissions",children:"Permissions"}),"\n",(0,o.jsx)(n.h3,{id:"android",children:"Android"}),"\n",(0,o.jsxs)(n.p,{children:["This library automatically adds ",(0,o.jsx)(n.code,{children:"READ_CONTACTS"})," and ",(0,o.jsx)(n.code,{children:"WRITE_CONTACTS"})," permissions to your app:"]}),"\n",(0,o.jsx)(d.K,{permissions:["READ_CONTACTS","WRITE_CONTACTS"]}),"\n",(0,o.jsx)(n.h3,{id:"ios",children:"iOS"}),"\n",(0,o.jsx)(n.p,{children:"The following usage description keys are used by this library:"}),"\n",(0,o.jsx)(d.U,{permissions:["NSContactsUsageDescription"]})]})}function f(){let e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:{},{wrapper:n}=(0,s._)({},(0,r.R)(),e.components);return n?(0,o.jsx)(n,(0,i._)((0,s._)({},e),{children:(0,o.jsx)(x,(0,s._)({},e))})):x(e)}a()}catch(e){a(e)}})},70402:(e,n,t)=>{"use strict";t.d(n,{B:()=>o});var a=t(37876),s=t(14232),i=t(34107);let o=e=>{let{children:n,abstract:t,title:o}=e;return t?null!=o||(o="Working in an existing React Native app?"):null!=o||(o="Are you using this library in an existing React Native app?"),(0,s.useEffect)(()=>{if("string"==typeof n)throw Error("Content inside 'ConfigReactNative' needs to be surrounded by new lines to be parsed as markdown.\n\nMake sure there is a blank new line before and after this content: '".concat(n,"'"))},[n]),(0,a.jsx)(i.N,{summary:o,children:n})}},77455:(e,n,t)=>{"us